import { Button, VerticalBox, LineEdit } from "std-widgets.slint";

struct VaultData {
    name: string,
    path: string,
    locked: bool,
}

struct FileData {
    name: string,
    path: string,
}

component StyledCheckBox inherits Rectangle {
    in-out property <bool> checked;
    in-out property <string> text;
    callback toggled();
    
    height: 24px;
    background: transparent;
    
    TouchArea {
        clicked => {
            checked = !checked;
            root.toggled();
        }
        
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                border-width: 1px;
                border-color: checked ? #3a86ff : #6c7a9c;
                background: checked ? #3a86ff : #1c202b;
                
                if checked : Text {
                    text: "✓";
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            
            Text {
                text: root.text;
                color: #ffffff;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

export component AppWindow inherits Window {
    width: 900px;
    height: 650px;
    title: "Cryptomator RS - Rust Edition";
    background: #0f1115;
    default-font-size: 14px;

    // Model properties connected to Rust
    in-out property <[VaultData]> vaults: [
        { name: "Personal Documents", path: "/home/user/vaults/personal", locked: true },
        { name: "Tax Returns", path: "/home/user/vaults/taxes", locked: false }
    ];
    in-out property <int> active-vault-index: -1;
    in-out property <string> active-view: "welcome"; // "welcome", "locked", "unlocked", "files", "create_wizard"
    in-out property <string> status-message: "";
    in-out property <bool> status-is-error: false;
    in-out property <[FileData]> vault-files: [];

    // Form inputs
    in-out property <string> password-input: "";
    in-out property <string> new-vault-name: "";
    in-out property <string> new-vault-path: "";
    in-out property <string> new-vault-password: "";
    in-out property <string> new-file-name: "";
    in-out property <string> new-file-content: "";

    // Keyfile & Auto-lock properties
    in-out property <string> new-vault-keyfile-path: "";
    in-out property <bool> new-vault-use-keyfile: false;
    in-out property <string> unlock-keyfile-path: "";
    in-out property <bool> unlock-use-keyfile: false;
    in-out property <bool> auto-lock-enabled: false;
    in-out property <string> auto-lock-timeout-minutes: "10";
    
    // Stats & Throughput properties
    in-out property <[int]> throughput-history: [2, 5, 8, 12, 10, 5, 3, 2, 4, 15, 25, 45, 35, 20, 10, 5, 3, 4, 6, 8, 10, 8, 5, 4, 3];
    in-out property <string> read-throughput: "0.0 KB/s";
    in-out property <string> write-throughput: "0.0 KB/s";

    // Callbacks to Rust
    callback select-vault(int);
    callback unlock-vault(string); // password
    callback lock-vault();
    callback add-existing-vault();
    callback select-new-vault-folder();
    callback select-new-vault-keyfile();
    callback select-unlock-keyfile();
    callback create-new-vault(string, string, string); // name, path, password
    callback refresh-files();
    callback import-file();
    callback export-file(string); // file name
    callback delete-file(string); // file name
    callback create-text-file(string, string); // file name, content
    callback show-create-wizard();
    callback show-files-view();
    callback cancel-wizard();

    HorizontalLayout {
        // --- SIDEBAR ---
        Rectangle {
            width: 280px;
            background: #161920;
            border-color: #232733;
            border-width: 1px;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                // Logo/Header
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "🔒";
                        font-size: 24px;
                    }
                    VerticalLayout {
                        Text {
                            text: "Cryptomator RS";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Rust & Slint Vaults";
                            color: #6c7a9c;
                            font-size: 10px;
                            font-weight: 500;
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: #232733;
                }

                // Vaults List Label
                HorizontalLayout {
                    Text {
                        text: "VAULTS";
                        color: #6c7a9c;
                        font-size: 11px;
                        font-weight: 700;
                    }
                }

                // Scrollable/List container of Vaults
                VerticalLayout {
                    spacing: 8px;
                    for vault[idx] in root.vaults : Rectangle {
                        height: 54px;
                        background: (idx == root.active-vault-index) ? #232836 : #1c202b;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: (idx == root.active-vault-index) ? #3a86ff : #232733;

                        TouchArea {
                            clicked => { root.select-vault(idx); }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: center;

                                Text {
                                    text: vault.locked ? "🔒" : "🔓";
                                    font-size: 18px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: vault.name;
                                        color: #ffffff;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: vault.path;
                                        color: #6c7a9c;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: #232733;
                }
                
                // Settings Header
                Text {
                    text: "SETTINGS";
                    color: #6c7a9c;
                    font-size: 11px;
                    font-weight: 700;
                }
                
                // Auto-lock toggle
                StyledCheckBox {
                    text: "Auto-Lock on Idle";
                    checked: root.auto-lock-enabled;
                    toggled => {
                        root.auto-lock-enabled = self.checked;
                    }
                }
                
                if root.auto-lock-enabled : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Timeout (min):";
                        color: #a0a5b5;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        width: 60px;
                        text: root.auto-lock-timeout-minutes;
                        edited(val) => { root.auto-lock-timeout-minutes = val; }
                    }
                }
                
                Rectangle {}

                // Sidebar buttons
                VerticalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: "➕ Create New Vault";
                        clicked => { root.show-create-wizard(); }
                    }

                    Button {
                        text: "📂 Add Existing Vault";
                        clicked => { root.add-existing-vault(); }
                    }
                }
            }
        }

        // --- MAIN WORKSPACE ---
        Rectangle {
            background: #0f1115;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Status Message Bar (top)
                if root.status-message != "" : Rectangle {
                    height: 40px;
                    background: root.status-is-error ? #3d1c1c : #1c3d23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.status-is-error ? #8c2e2e : #2e8c45;
                    
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.status-message;
                            color: #ffffff;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                // VIEW: Welcome Screen
                if root.active-view == "welcome" : VerticalLayout {
                    alignment: center;
                    spacing: 20px;

                    Text {
                        text: "Welcome to Cryptomator RS";
                        color: #ffffff;
                        font-size: 26px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Protect your cloud storage using advanced client-side encryption.\nSelect an existing vault from the sidebar or create a new one to begin.";
                        color: #a0a5b5;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 20px;
                        
                        Rectangle {
                            width: 180px;
                            height: 120px;
                            background: #161920;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #232733;

                            TouchArea {
                                clicked => { root.show-create-wizard(); }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text { text: "➕"; font-size: 28px; horizontal-alignment: center; }
                                    Text { text: "New Vault"; color: #ffffff; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                                }
                            }
                        }

                        Rectangle {
                            width: 180px;
                            height: 120px;
                            background: #161920;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #232733;

                            TouchArea {
                                clicked => { root.add-existing-vault(); }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text { text: "📂"; font-size: 28px; horizontal-alignment: center; }
                                    Text { text: "Open Vault"; color: #ffffff; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // VIEW: Create Wizard Screen
                if root.active-view == "create_wizard" : VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: "Create New Vault";
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: 700;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Vault Name:"; color: #a0a5b5; font-size: 12px; }
                        LineEdit {
                            text: root.new-vault-name;
                            placeholder-text: "e.g., SecureDrive";
                            edited(val) => { root.new-vault-name = val; }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Vault Folder Location:"; color: #a0a5b5; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text: root.new-vault-path;
                                placeholder-text: "Choose directory where encrypted vault data will reside...";
                                edited(val) => { root.new-vault-path = val; }
                            }
                            Button {
                                text: "Browse...";
                                clicked => { root.select-new-vault-folder(); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Passphrase:"; color: #a0a5b5; font-size: 12px; }
                        LineEdit {
                            text: root.new-vault-password;
                            placeholder-text: "Enter a strong password...";
                            input-type: password;
                            edited(val) => { root.new-vault-password = val; }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        StyledCheckBox {
                            text: "Use Keyfile (KeePass-style)";
                            checked: root.new-vault-use-keyfile;
                            toggled => { root.new-vault-use-keyfile = self.checked; }
                        }
                        if root.new-vault-use-keyfile : HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text: root.new-vault-keyfile-path;
                                placeholder-text: "Path to keyfile...";
                                edited(val) => { root.new-vault-keyfile-path = val; }
                            }
                            Button {
                                text: "Select Keyfile...";
                                clicked => { root.select-new-vault-keyfile(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;
                        
                        Button {
                            text: "Cancel";
                            clicked => { root.cancel-wizard(); }
                        }

                        Button {
                            text: "Create Vault";
                            clicked => { root.create-new-vault(root.new-vault-name, root.new-vault-path, root.new-vault-password); }
                        }
                    }
                }

                // VIEW: Locked Screen
                if root.active-view == "locked" : VerticalLayout {
                    alignment: center;
                    spacing: 24px;

                    // Large Lock Icon & Name
                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "🔒";
                            font-size: 64px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.active-vault-index >= 0 ? root.vaults[root.active-vault-index].name : "";
                            color: #ffffff;
                            font-size: 22px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.active-vault-index >= 0 ? root.vaults[root.active-vault-index].path : "";
                            color: #6c7a9c;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }

                    // Password Form
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            width: 320px;
                            spacing: 12px;

                            LineEdit {
                                text: root.password-input;
                                placeholder-text: "Enter vault password...";
                                input-type: password;
                                edited(val) => { root.password-input = val; }
                            }

                            StyledCheckBox {
                                text: "Use Keyfile";
                                checked: root.unlock-use-keyfile;
                                toggled => { root.unlock-use-keyfile = self.checked; }
                            }

                            if root.unlock-use-keyfile : HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text: root.unlock-keyfile-path;
                                    placeholder-text: "Path to keyfile...";
                                    edited(val) => { root.unlock-keyfile-path = val; }
                                }
                                Button {
                                    text: "Browse...";
                                    clicked => { root.select-unlock-keyfile(); }
                                }
                            }

                            Button {
                                text: "Unlock Vault";
                                clicked => { root.unlock-vault(root.password-input); }
                            }
                        }
                    }
                }

                // VIEW: Unlocked Screen
                if root.active-view == "unlocked" : VerticalLayout {
                    spacing: 20px;
                    
                    // Header Status
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "🔓"; font-size: 32px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.active-vault-index >= 0 ? root.vaults[root.active-vault-index].name : "";
                                color: #ffffff;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Vault status: Unlocked and Ready";
                                color: #4caf50;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }
                        Rectangle {}
                        Button {
                            text: "🔒 Lock Vault";
                            clicked => { root.lock-vault(); }
                        }
                    }

                    // Vault Stats Card
                    Rectangle {
                        background: #161920;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #232733;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Text {
                                text: "Vault Details";
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                Text { text: "Path:"; color: #6c7a9c; width: 100px; }
                                Text { text: root.active-vault-index >= 0 ? root.vaults[root.active-vault-index].path : ""; color: #ffffff; }
                            }
                            HorizontalLayout {
                                Text { text: "Virtual Drive:"; color: #6c7a9c; width: 100px; }
                                Text { text: "Simulated Cryptomator FS (Decrypted inside application)"; color: #ffffff; }
                            }
                            HorizontalLayout {
                                Text { text: "Encryption:"; color: #6c7a9c; width: 100px; }
                                Text { text: "AES-256-GCM, Scrypt Key Derivation"; color: #ffffff; }
                            }
                        }
                    }

                    // Throughput Card
                    Rectangle {
                        background: #161920;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #232733;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            
                            // Stats title and numeric displays
                            HorizontalLayout {
                                Text {
                                    text: "Real-time Throughput";
                                    color: #ffffff;
                                    font-size: 14px;
                                    font-weight: 700;
                                }
                                Rectangle {}
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Read: " + root.read-throughput;
                                        color: #3a86ff;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Write: " + root.write-throughput;
                                        color: #4cc9f0;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                }
                            }
                            
                            // Bar chart graph
                            HorizontalLayout {
                                height: 60px;
                                spacing: 3px;
                                alignment: center;
                                for val in root.throughput-history : Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: end;
                                        Rectangle {
                                            width: 8px;
                                            height: val * 0.55px;
                                            background: @linear-gradient(180deg, #4cc9f0 0%, #3a86ff 100%);
                                            border-radius: 1px;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Action Grid
                    HorizontalLayout {
                        spacing: 16px;
                        
                        Button {
                            text: "📁 Browse Encrypted Files";
                            clicked => { root.show-files-view(); }
                        }
                    }
                }

                // VIEW: Files Explorer (Inside Vault)
                if root.active-view == "files" : VerticalLayout {
                    spacing: 16px;

                    // Navigation bar
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Button {
                            text: "⬅ Back to Vault";
                            clicked => { root.show-files-view(); } // actually toggled in main
                        }
                        Text {
                            text: root.active-vault-index >= 0 ? root.vaults[root.active-vault-index].name + " > Files" : "Files";
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {}
                        Button {
                            text: "🔄 Refresh";
                            clicked => { root.refresh-files(); }
                        }
                        Button {
                            text: "📥 Import File";
                            clicked => { root.import-file(); }
                        }
                    }

                    // Create file panel
                    Rectangle {
                        background: #161920;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #232733;
                        height: 120px;
                        
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 8px;
                                width: 200px;
                                Text { text: "Create Text File:"; color: #ffffff; font-size: 11px; font-weight: 700; }
                                LineEdit {
                                    text: root.new-file-name;
                                    placeholder-text: "filename.txt";
                                    edited(val) => { root.new-file-name = val; }
                                }
                                Button {
                                    text: "Save File to Vault";
                                    clicked => { root.create-text-file(root.new-file-name, root.new-file-content); }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "File Content:"; color: #ffffff; font-size: 11px; font-weight: 700; }
                                LineEdit {
                                    text: root.new-file-content;
                                    placeholder-text: "Write secret text here...";
                                    edited(val) => { root.new-file-content = val; }
                                }
                            }
                        }
                    }

                    // Files list
                    Rectangle {
                        background: #161920;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #232733;
                        
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            if root.vault-files.length == 0 : VerticalLayout {
                                alignment: center;
                                height: 200px;
                                Text {
                                    text: "No files found in this vault.";
                                    color: #6c7a9c;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Click 'Import File' or create a text file above to encrypt files into the vault.";
                                    color: #6c7a9c;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }

                            for file in root.vault-files : Rectangle {
                                height: 40px;
                                background: #1c202b;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #232733;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: center;

                                    Text {
                                        text: "📄";
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: file.name;
                                        color: #ffffff;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {}

                                    Button {
                                        text: "📤 Export";
                                        clicked => { root.export-file(file.name); }
                                    }

                                    Button {
                                        text: "❌ Delete";
                                        clicked => { root.delete-file(file.name); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
